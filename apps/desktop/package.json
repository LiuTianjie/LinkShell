{
  "name": "@linkshell/desktop",
  "version": "0.10.74",
  "private": true,
  "description": "LinkShell desktop: the Electron window inside LinkShell.app (com.bd.linkshell.host).",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-native.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
