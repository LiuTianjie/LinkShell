{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "resolveJsonModule": true,
    "paths": {
      "@linkshell/wire": ["../../packages/wire/src/index.ts"],
      "@linkshell/client-core": ["../../packages/client-core/src/index.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
