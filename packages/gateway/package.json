{
  "name": "@linkshell/gateway",
  "version": "0.6.10",
  "description": "LinkShell gateway: relays end-to-end encrypted frames between computers and devices, and brokers pairing.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiuTianjie/LinkShell.git",
    "directory": "packages/gateway"
  },
  "type": "module",
  "main": "dist/gateway/src/index.js",
  "types": "dist/gateway/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/gateway/src/index.d.ts",
      "import": "./dist/gateway/src/index.js",
      "default": "./dist/gateway/src/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE",
    "Dockerfile",
    "web-client",
    "scripts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist *.tsbuildinfo && tsc -p tsconfig.json",
    "prepack": "pnpm run build && pnpm run build:web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/main.ts",
    "test": "vitest run",
    "build:web": "node scripts/build-web.mjs"
  },
  "dependencies": {
    "@linkshell/wire": "workspace:*",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.3",
    "vitest": "^3.2.1"
  },
  "engines": {
    "node": ">=22.13"
  }
}
