{
  "name": "@linkshell/wire",
  "version": "0.2.6",
  "description": "Wire protocol for LinkShell v2: session model, JSON-RPC methods, end-to-end encryption and the relay client.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiuTianjie/LinkShell.git",
    "directory": "packages/wire"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist *.tsbuildinfo && tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "vitest": "^3.2.1"
  },
  "react-native": "src/index.ts",
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  }
}
