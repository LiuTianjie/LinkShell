{
  "name": "@linkshell/host",
  "version": "0.4.13",
  "description": "LinkShell v2 host daemon: owns agent sessions and terminals on your computer, serves them to your devices.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiuTianjie/LinkShell.git",
    "directory": "packages/host"
  },
  "type": "module",
  "main": "dist/host/src/index.js",
  "types": "dist/host/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/host/src/index.d.ts",
      "import": "./dist/host/src/index.js",
      "default": "./dist/host/src/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "scripts/postinstall.mjs"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "rm -rf dist *.tsbuildinfo && tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "live:codex": "tsx scripts/live-codex-check.ts",
    "live:claude": "tsx scripts/live-claude-check.ts",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.84.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.284",
    "@linkshell/wire": "workspace:*",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0",
    "sharp": "^0.35.5",
    "werift": "^0.22.9",
    "ws": "^8.21.0",
    "zod": "^3.24.3"
  },
  "optionalDependencies": {
    "@linkshell/mac": "workspace:*"
  },
  "devDependencies": {
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.3",
    "vitest": "^3.2.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
