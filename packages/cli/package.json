{
  "name": "linkshell-cli",
  "version": "0.10.0",
  "description": "Follow, steer and approve the coding agents on your computer (Claude Code, Codex, Gemini, Copilot and more) from your phone",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "linkshell": "dist/cli/src/index.js"
  },
  "files": [
    "dist",
    "src",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "terminal",
    "remote",
    "claude",
    "codex",
    "pty",
    "bridge",
    "mobile",
    "websocket"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiuTianjie/LinkShell.git"
  },
  "scripts": {
    "build": "rm -rf dist *.tsbuildinfo && tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "postinstall": "node scripts/postinstall.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@linkshell/gateway": "workspace:*",
    "commander": "^13.1.0",
    "node-pty": "^1.1.0",
    "qrcode-terminal": "^0.12.0",
    "@linkshell/host": "workspace:*",
    "@linkshell/wire": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "vitest": "^3.2.1"
  },
  "engines": {
    "node": ">=22.13"
  }
}
